# Copy to .env and tweak as needed.
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://failsafe:failsafe@localhost:5432/failsafe
# For local dev (default), SQLite:
DATABASE_URL=sqlite:///./failsafe.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# Path to artefacts produced by the ML pipeline (relative to repo root).
ML_MODEL_PATH=../ml/models/xgb_failsafe.json
ML_PIPELINE_PATH=../ml/models/preprocessor.joblib
ML_BACKGROUND_PATH=../ml/models/shap_background.npy
ML_METADATA_PATH=../ml/models/metadata.json

# CORS — comma-separated origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
